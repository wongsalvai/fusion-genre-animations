{
  "filters": [
    {
      "borderColor": "#FF858283",
      "groupId": "gr",
      "id": "r-4k",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/4k.png",
      "isEnabled": true,
      "name": "4K",
      "pattern": "(?i)(?=(?:^|[\\s._\\-\\[\\(])(?:2160[pi]?|2016[pi]?|4k|uhd)(?:$|[\\s._\\-\\]\\)]))(?!.*\\b(?:1080[pi]?|720[pi]?)\\b).+",
      "tagColor": "#33FFFFFF",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },
    {
      "borderColor": "#FF858283",
      "groupId": "gr",
      "id": "r-1080",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/fhd.png",
      "isEnabled": true,
      "name": "1080p",
      "pattern": "(?i)\\b1080[pi]?\\b",
      "tagColor": "#33FFFFFF",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },
    {
      "borderColor": "#FF858283",
      "groupId": "gr",
      "id": "r-720",
      "isEnabled": true,
      "name": "720p",
      "pattern": "(?i)\\b720[pi]?\\b",
      "tagColor": "#33FFFFFF",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },
    {
      "borderColor": "#FF858283",
      "groupId": "gr",
      "id": "r-480",
      "isEnabled": true,
      "name": "480p",
      "pattern": "(?i)\\b(?:480p|480i|sd|dvd.?rip|dvdrip|dvd rip|dvd-rip|576p|852x480|848x480|854x480)\\b",
      "tagColor": "#33FFFFFF",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },

    {
      "borderColor": "#FF858283",
      "groupId": "gq",
      "id": "q-r",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/mono-remux.png",
      "isEnabled": true,
      "name": "REMUX",
      "pattern": "(?i)(?:^|[\\s._-])(?:remux|blu.?ray.?remux|bluray.?remux|blu-ray.?remux|bdremux|bd[\\s._-]?remux|uhd[\\s._-]?remux|uhdbdremux|uhd-bdremux|uhdblu.?ray.?remux|bdrip.?remux)(?:$|[\\s._-])(?!.*(?:bluray|blu.?ray|bdrip|brrip|bd25|bd50))",
      "tagColor": "#33FFFFFF",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },
    {
      "borderColor": "#FF858283",
      "groupId": "gq",
      "id": "q-b",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/mono-bluray.png",
      "isEnabled": true,
      "name": "BLURAY",
      "pattern": "(?i)\\b(?:bluray|blu.?ray|bdrip|brrip|bd25|bd50|bd)\\b(?!.*remux)",
      "tagColor": "#33FFFFFF",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },

    {
      "borderColor": "#FF858283",
      "groupId": "gq",
      "id": "q-w",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/mono-webdl.png",
      "isEnabled": true,
      "name": "WEB",
      "pattern": "(?i)^(?=.*(?:WEB[-_. ]DL(?:mux)?|WEBDL|WebRip|Web-Rip|WEBMux|(?:720|1080|2160)p[-. ]WEB[-. ]|[-. ]WEB[-. ](?:720|1080|2160)p|(?:AMZN|NF|DP)[. -]WEB[. -]))",
      "tagColor": "#33FFFFFF",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },

    {
      "borderColor": "#00000000",
      "groupId": "ga",
      "id": "a-dts",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/dts.png",
      "isEnabled": true,
      "name": "DTS",
      "pattern": "(?i)\\bdts\\b(?![\\s._-]?x|[\\s._-]?hd)",
      "type": "filter"
    },

    {
      "borderColor": "#00000000",
      "groupId": "ga",
      "id": "a-dtshdma",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/dtshd.png",
      "isEnabled": true,
      "name": "DTS-HD MA",
      "pattern": "(?i)dts[\\s._-]?hd[\\s._-]?(ma|master audio)?",
      "type": "filter"
    },

    {
      "borderColor": "#00000000",
      "groupId": "ga",
      "id": "a-dtsx",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/dtsx.png",
      "isEnabled": true,
      "name": "DTS:X",
      "pattern": "(?i)dts[\\s._-]?x",
      "type": "filter"
    },

    {
      "borderColor": "#00000000",
      "groupId": "ga",
      "id": "a-at",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/atmos.png",
      "isEnabled": true,
      "name": "Atmos",
      "pattern": "(?i)^(?=.*\\batmos\\b)(?!.*\\btrue[\\s._-]?hd\\b)(?!.*\\b(?:dv|dovi|dolby[\\s._-]?vision)\\b).+",
      "type": "filter"
    },

    {
      "borderColor": "#00000000",
      "groupId": "ga",
      "id": "a-th",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/truehd.png",
      "isEnabled": true,
      "name": "TrueHD",
      "pattern": "(?i)^(?=.*\\btrue[\\s._-]?hd\\b)(?!.*\\batmos\\b)(?!.*\\b(?:dv|dovi|dolby[\\s._-]?vision)\\b).+",
      "type": "filter"
    }
  ],

  "groups": [
    {
      "borderColor": "#FF858283",
      "color": "#FFBE01",
      "id": "gr",
      "isExpanded": true,
      "name": "Resolution"
    },
    {
      "borderColor": "#FF00FF37",
      "color": "#27C04F",
      "id": "gq",
      "isExpanded": true,
      "name": "Quality"
    },
    {
      "borderColor": "#00000000",
      "color": "#45B7D1",
      "id": "ga",
      "isExpanded": true,
      "name": "Audio"
    },
    {
      "borderColor": "#FF858283",
      "color": "#FF6B6B",
      "id": "gv",
      "isExpanded": true,
      "name": "Visual"
    },
    {
      "borderColor": "#FF858283",
      "color": "#FF6B6B",
      "id": "editions",
      "isExpanded": true,
      "name": "editions"
    }
  ]
}
