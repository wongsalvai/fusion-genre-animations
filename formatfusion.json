      "isEnabled": true,
      "name": "TrueHD+DV",
      "pattern": "(?i)(?=.*\\btrue[\\s._-]?hd\\b)(?=.*\\b(?:dv|dovi|dolby[\\s._-]?vision)\\b).+",
