      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },
    {
      "borderColor": "#FF858283",
      "groupId": "gr",
      "id": "r-480",
      "isEnabled": true,
      "name": "480p",
      "pattern": "(?i)\\b(?:480p|480i|sd|dvd.?rip|dvdrip|dvd rip|dvd-rip|576p|852x480|848x480|854x480)\\b",
      "tagColor": "#33FFFFFF",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },
    {
      "borderColor": "#FF858283",
      "groupId": "gq",
      "id": "q-r",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/mono-remux.png",
      "isEnabled": true,
      "name": "REMUX",
      "pattern": "(?i)(?:^|[\\s._-])(?:remux|blu.?ray.?remux|bluray.?remux|blu-ray.?remux|bdremux|bd[\\s._-]?remux|uhd[\\s._-]?remux|uhdbdremux|uhd-bdremux|uhdblu.?ray.?remux|bdrip.?remux)(?:$|[\\s._-])(?!.*(?:bluray|blu.?ray|bdrip|brrip|bd25|bd50))",
      "tagColor": "#33FFFFFF",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },
    {
      "borderColor": "#FF858283",
      "groupId": "gq",
      "id": "q-b",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/mono-bluray.png",
      "isEnabled": true,
      "name": "BLURAY",
      "pattern": "(?i)\\b(?:bluray|blu.?ray|bdrip|brrip|bd25|bd50|bd)\\b(?!.*remux)",
      "tagColor": "#33FFFFFF",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },
    {
      "borderColor": "#FF858283",
      "groupId": "gq",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/mono-webdl.png",
      "id": "q-w",
      "isEnabled": true,
      "name": "WEB",
      "pattern": "(?i)^(?=.*(?:WEB[-_. ]DL(?:mux)?|WEBDL|WebRip|Web-Rip|WEBMux|(?:720|1080|2160)p[-. ]WEB[-. ]|[-. ]WEB[-. ](?:720|1080|2160)p|(?:AMZN|NF|DP)[. -]WEB[. -]))",
      "tagColor": "#33FFFFFF",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },
    {
      "borderColor": "#FF858283",
      "groupId": "gv",
      "id": "v-imax",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/IMAX.png",
      "isEnabled": true,
      "name": "IMAX",
      "pattern": "(?i)\\bimax(?:[\\s._-]?enhanced)?\\b",
      "tagColor": "#00000000",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },
    {
      "borderColor": "#00000000",
