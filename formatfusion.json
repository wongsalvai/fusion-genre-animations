{
  "filters": [
    {
      "borderColor": "#FF858283",
      "groupId": "gr",
      "id": "r-4k",
      "isEnabled": true,
      "name": "4K",
      "pattern": "(?i)(?=(?:^|[\\s._-])(?:2160[pi]?|2016[pi]?|4k|uhd)(?:$|[\\s._-]))(?!.*\\b(?:1080[pi]?|720[pi]?)\\b).+",
      "tagColor": "#33FFFFFF",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },
    {
      "borderColor": "#FF858283",
      "groupId": "gr",
      "id": "r-1080",
      "isEnabled": true,
      "name": "1080p",
      "pattern": "(?i)\\b1080[pi]?\\b",
      "tagColor": "#33FFFFFF",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },
    {
      "borderColor": "#FF858283",
      "groupId": "gr",
