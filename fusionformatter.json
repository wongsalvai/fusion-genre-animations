      "isEnabled": true,
      "name": "REMUX",
      "pattern": "(?i)\\b(?:remux|blu.?ray.?remux|bluray.?remux|bdremux|uhd\\s?(?:bd)?\\s?remux|bdrip\\s?remux)\\b",
      "tagColor": "#33FFFFFF",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },

    {
      "borderColor": "#FF858283",
      "groupId": "gq",
      "id": "q-b",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/mono-bluray.png",
      "isEnabled": true,
      "name": "BLURAY",
      "pattern": "(?i)\\b(?:bluray|blu.?ray|bdrip|brrip|bd25|bd50|bd)\\b(?!.*\\b(?:remux|uhd\\s?(?:bd)?\\s?remux|blu.?ray.?remux|bdremux)\\b)",
      "tagColor": "#33FFFFFF",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },

    {
      "borderColor": "#FF858283",
      "groupId": "gq",
      "id": "q-w",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/mono-webdl.png",
      "isEnabled": true,
      "name": "WEBDL",
      "pattern": "(?i)web[\\s._-]?dl(?![a-z0-9])",
      "tagColor": "#33FFFFFF",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },

    {
      "borderColor": "#FF858283",
      "groupId": "gq",
      "id": "q-wr",
      "imageURL": "https://raw.githubusercontent.com/wongsalvai/fusion-genre-animations/refs/heads/main/rip10.png",
      "isEnabled": true,
      "name": "WEBRIP",
      "pattern": "(?i)webrip|web[\\s._-]?rip|hd[\\s._-]?rip|hc[\\s._-]?hd[\\s._-]?rip|dvd[\\s._-]?rip|hdtv",
      "tagColor": "#33FFFFFF",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },

    {
      "borderColor": "#FF858283",
      "groupId": "gv",
      "id": "v-imax",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/IMAX.png",
      "isEnabled": true,
      "name": "IMAX",
      "pattern": "(?i)\\bimax(?:[\\s._-]?enhanced)?\\b",
      "tagColor": "#474747",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },

    {
      "borderColor": "#00000000",
      "groupId": "gv",
      "id": "a-th-dv",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/truehd-vision.png",
      "isEnabled": true,
      "name": "TrueHD+DV",
      "pattern": "(?i)(?=.*\\btrue[\\s._-]?hd\\b)(?=.*\\b(?:dv|dovi|dolby[\\s._-]?vision)\\b).+",
