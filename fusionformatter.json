{
  "filters": [
    {
      "borderColor": "#FF858283",
      "groupId": "gr",
      "id": "r-4k",
      "isEnabled": true,
      "name": "UHD",
      "pattern": "(?i)(?=.*(?:2160p|4k|uhd))(?!.*\\b(?:1080p|720p)\\b).+",
      "tagColor": "#33FFFFFF",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },
    {
      "borderColor": "#FF858283",
      "groupId": "gr",
      "id": "r-1080",
      "isEnabled": true,
      "name": "FHD",
      "pattern": "(?i)\\b(fhd|hd)?1080[pi]?\\b",
      "tagColor": "#33FFFFFF",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },
    {
      "borderColor": "#FF858283",
      "groupId": "gr",
      "id": "r-720",
      "isEnabled": true,
      "name": "‎ HD‎ ",
      "pattern": "(?i)\\b(hd)?720[pi]?\\b",
      "tagColor": "#33FFFFFF",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },
    {
      "borderColor": "#FF858283",
      "groupId": "gr",
      "id": "r-480",
      "isEnabled": true,
      "name": "‎ SD‎ ",
      "pattern": "(?i)\\b(?:480p|480i|sd|dvd.?rip|dvdrip|dvd rip|dvd-rip|576p|852x480|848x480|854x480)\\b",
