      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },

    {
      "borderColor": "#00000000",
      "groupId": "gv",
      "id": "a-at-dv",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/atmos-vision.png",
      "isEnabled": true,
      "name": "Atmos+DV",
      "pattern": "(?i)^(?=.*\\batmos\\b)(?=.*\\b(?:dv|dovi|dolby[\\s._-]?vision)\\b)(?!.*\\btrue[\\s._-]?hd\\b).+",
      "tagColor": "#474747",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },

    {
      "borderColor": "#00000000",
      "groupId": "gv",
      "id": "a-dv",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/vision.png",
      "isEnabled": true,
      "name": "DV",
      "pattern": "(?i)^(?=.*\\b(?:dv|dovi|dolby[\\s._-]?vision)\\b)(?=.*\\b(?:atmos)\\b)?(?!.*\\btrue[\\s._-]?hd\\b).+",
      "tagColor": "#474747",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },

    {
      "borderColor": "#FF858283",
      "groupId": "gv",
      "id": "v-hdr10",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/HDR10.png",
      "isEnabled": true,
      "name": "HDR10",
      "pattern": "(?i)^(?!.*\\b(?:dv|dovi|dolby[\\s._-]?vision)\\b)(?=.*hdr[\\s._-]?10)",
      "tagColor": "#474747",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },

    {
      "borderColor": "#FF858283",
      "groupId": "gv",
      "id": "v-hdr",
      "isEnabled": true,
      "name": "HDR",
      "pattern": "(?i)^(?!.*\\b(?:dv|dovi|dolby[\\s._-]?vision)\\b)(?=.*\\bHDR\\b)(?!.*hdr[\\s._-]?10)",
      "tagColor": "#474747",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },

    {
      "borderColor": "#00000000",
      "groupId": "ga",
      "id": "a-th",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/truehd.png",
      "isEnabled": true,
      "name": "TrueHD",
      "pattern": "(?i)^(?=.*\\btrue[\\s._-]?hd)(?!.*\\b(?:dv|dovi|dolby[\\s._-]?vision)\\b).+",
      "tagColor": "#474747",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },

    {
      "borderColor": "#00000000",
      "groupId": "ga",
      "id": "a-at",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/atmos.png",
      "isEnabled": true,
      "name": "Atmos",
      "pattern": "(?i)^(?=.*\\batmos\\b)(?!.*\\btrue[\\s._-]?hd\\b)(?!.*\\b(?:dv|dovi|dolby[\\s._-]?vision)\\b).+",
      "tagColor": "#474747",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },

    {
      "borderColor": "#FF858283",
      "groupId": "ga",
      "id": "a-dtsx",
