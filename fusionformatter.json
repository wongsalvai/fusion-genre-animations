      "name": "DTS:X",
      "pattern": "(?i)\\bdts[-_.: ]?x\\b",
      "tagColor": "#474747",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },

    {
      "borderColor": "#FF858283",
      "groupId": "ga",
      "id": "a-dtsma",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/dtshdma.png",
      "isEnabled": true,
      "name": "DTS-HD MA",
      "pattern": "(?i)^(?=.*\\bdts[-_. ]?(?:hd[-_. ]?)?ma\\b)(?!.*\\bdts[-_.: ]?x\\b)",
      "tagColor": "#474747",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },

    {
      "borderColor": "#FF858283",
      "groupId": "ga",
      "id": "a-dtshd",
      "isEnabled": true,
      "name": "DTS-HD",
      "pattern": "(?i)^(?=.*\\bdts[-_. ]?hd\\b)(?!.*\\bdts[-_. ]?(?:hd[-_. ]?)?ma\\b)(?!.*\\bdts[-_.: ]?x\\b)",
      "tagColor": "#474747",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },

    {
      "borderColor": "#FF858283",
      "groupId": "ga",
      "id": "a-dts",
      "isEnabled": true,
      "name": "DTS",
      "pattern": "(?i)^(?=.*\\bDTS\\b)(?!.*\\bdts[-_. ]?(?:hd|ma|xll|x)\\b)",
