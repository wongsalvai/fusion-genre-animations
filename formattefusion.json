{
  "filters": [
    {
      "borderColor": "#FF858283",
      "groupId": "gr",
      "id": "r-4k",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/4k.png",
      "isEnabled": true,
      "name": "4K",
      "pattern": "(?i)(?=(?:^|[\\s._\\-\\[\\(])(?:2160p|4k|uhd)(?:$|[\\s._\\-\\]\\)]))(?!.*\\b(?:1080p|720p)\\b).+",
      "tagColor": "#33FFFFFF",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },
    {
      "borderColor": "#FF858283",
      "groupId": "gr",
      "id": "r-1080",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/fhd.png",
      "isEnabled": true,
      "name": "1080p",
      "pattern": "(?i)\\b1080p\\b",
      "tagColor": "#33FFFFFF",
      "tagStyle": "filled",
      "textColor": "#FFFFFF",
      "type": "filter"
    },

    {
      "borderColor": "#FF858283",
      "groupId": "gb",
      "id": "bit-4kweb",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/mono-webdl.png",
      "isEnabled": true,
      "name": "4K WEB",
      "pattern": "(?i)(?=.*(?:2160p|4k|uhd))(?=.*(?:web|web[-_. ]?dl|webrip))(?!.*remux)(?!.*bluray).+",
      "tagColor": "#00000000",
      "tagStyle": "filled",
      "textColor": "#edeaca",
      "type": "filter"
    },

    {
      "borderColor": "#FF858283",
      "groupId": "gb",
      "id": "bit-fhdbluray",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/mono-bluray.png",
      "isEnabled": true,
      "name": "FHD BLURAY",
      "pattern": "(?i)(?=.*(?:1080p|720p))(?=.*(?:bluray|blu.?ray|bdrip|brrip))(?!.*remux)(?!.*web).+",
      "tagColor": "#00000000",
      "tagStyle": "filled",
      "textColor": "#cfd8dc",
      "type": "filter"
    },

    {
      "borderColor": "#00000000",
      "groupId": "gl",
      "id": "l-pl",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/pl.png",
      "isEnabled": true,
      "name": "🇵🇱 PL",
      "pattern": "(?i)(\\bpolish\\b|\\bpolska\\b|\\bnapisy\\s?pl\\b|\\[pl\\])(?=.*(?!multi))",
      "tagColor": "#00000000",
      "tagStyle": "filled",
      "textColor": "#80FFFFFF",
      "type": "filter"
    },
    {
      "borderColor": "#00000000",
      "groupId": "gl",
      "id": "l-mu",
      "imageURL": "https://raw.githubusercontent.com/9mousaa/BetterFormatter/main/images/multi.png",
      "isEnabled": true,
      "name": "🌐 MULTI",
      "pattern": "(?i)\\bmulti\\b|\\bdual[\\s._-]?audio\\b",
      "tagColor": "#00000000",
      "tagStyle": "filled",
      "textColor": "#80FFFFFF",
      "type": "filter"
    }
  ],

  "groups": [
    {
      "borderColor": "#FF858283",
      "color": "#FFBE01",
      "id": "gr",
      "isExpanded": true,
      "name": "Resolution"
    },
    {
      "borderColor": "#FF00FF37",
      "color": "#27C04F",
      "id": "gb",
      "isExpanded": true,
      "name": "Bitrate"
    },
    {
      "borderColor": "#00000000",
      "color": "#4ECDC4",
      "id": "gl",
      "isExpanded": true,
      "name": "Language"
    }
  ]
}
